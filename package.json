{
  "name": "dsh-video-zxk",
  "version": "0.1.0",
  "description": "让 DSH 看懂视频：画面 + 声音 + 时间轴 → 结构化理解结果（不生成视频）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:local": "node --test --test-isolation=none tests/*.test.mjs",
    "prepublishOnly": "node scripts/prepublish-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "video",
    "whisper",
    "ffmpeg"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owl-zxk/dsh-video.git"
  },
  "homepage": "https://github.com/owl-zxk/dsh-video#readme",
  "bugs": {
    "url": "https://github.com/owl-zxk/dsh-video/issues"
  }
}
